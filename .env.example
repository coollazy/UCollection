# Copy to .env and adjust for your deployment.
# See docs/CLAUDE.md and docs/開發流程框架-03-技術架構設計.md 第1節.

LISTEN_PORT=8080
ENVIRONMENT=production

POSTGRES_USER=ucollection
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ucollection

# Merchant-facing origin, e.g. https://pay.merchant.com — used to build
# checkout page URLs and (later) for Origin-header CSRF checks. Required;
# the app fails fast at startup if unset.
PUBLIC_ORIGIN=https://pay.merchant.example

# TRC20 USDT contract internal/scanner watches for Transfer events. Mainnet
# shown below; use a Shasta testnet contract + TRONGRID_BASE_URL for testing.
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Optional: defaults to https://api.trongrid.io if unset.
# TRONGRID_BASE_URL=https://api.trongrid.io
# Optional: TronGrid allows unauthenticated requests at a lower rate limit.
# TRONGRID_API_KEY=
